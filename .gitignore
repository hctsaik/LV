**/__pycache__/
**/bin/
**/include/
**/lib/
**/share/
pyvenv.cfg
**/Dinov2_model
**/output/
**/quary/
**/tracing/
.venv/
.pycache_local/
.DS_Store
CLAUDE.md

# Model weights — large binaries, NOT committed (download via scripts/setup_models.py;
# see MODELS.md). The named placeholder FOLDERS under models/ ARE committed (.gitkeep)
# so you can see where each model goes; everything else under models/ is ignored.
models/**
!models/**/
!models/**/.gitkeep

# Dataset & goal images
dataset/
goal/

# App-side caches (object crops / embeddings / thumbnails) — kept OUT of user
# datasets so analysing a dataset never dirties the user's folder. Regenerated.
.lv_cache/
# Embedding caches (regenerated on first run)
**/embeddings_*/
# Local data & generated artifacts (not for version control)
datasets/
demo/
streamlit_log.txt
streamlit_*.log
**/.thumbs/
tests/e2e/_server.log
# 桶① gate calibration (modality-specific; written by calibrate_signal_gate.py --write)
signal_gate.json
# object-embedding policy profiles (dataset-specific; written by object_eval.py)
object_policy_profiles.json
# remembered UI selections (per-user; written by the app)
.lv_ui_state.json
output/curation_log.jsonl

# throwaway prototypes
scratch/
